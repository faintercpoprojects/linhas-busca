// Regras de segurança do Firestore (já publicadas no projeto).
// Acesso (leitura e escrita) SOMENTE para usuários autenticados (login).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
